{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "neurosym/report_schema_v0",
  "title": "NeuroSym clinician report (contract v0 - draft until the model publishes docs/report_schema.json)",
  "type": "object",
  "required": ["schema_version", "recording_id", "answer", "data_quality", "features", "scores",
               "guarantee_note", "limitations"],
  "properties": {
    "schema_version": {"type": "string"},
    "recording_id": {"type": "string"},
    "model_version": {"type": "string"},
    "answer": {"enum": ["WITHIN_NORMATIVE_RANGE", "INCONCLUSIVE_REPEAT", "OUTSIDE_NORMATIVE_RANGE_REVIEW"]},
    "answer_reasons": {"type": "array", "items": {"type": "string"}},
    "context": {"type": "object"},
    "data_quality": {"type": "object", "required": ["status"], "properties": {
        "status": {"enum": ["PASS", "WARN", "FAIL"]},
        "bad_channels": {"type": "array", "items": {"type": "string"}},
        "clean_trials_per_condition": {"type": "object", "additionalProperties": {"type": "number"}},
        "sync": {"type": "object"},
        "notes": {"type": "array", "items": {"type": "string"}}}},
    "features": {"type": "array", "items": {"type": "object", "required": ["name", "value"],
        "properties": {"name": {"type": "string"}, "label": {"type": "string"},
                       "value": {"type": ["number", "null"]}, "unit": {"type": "string"},
                       "z": {"type": ["number", "null"]}, "percentile": {"type": ["number", "null"]},
                       "hemisphere": {"type": "string"}, "hand": {"type": "string"},
                       "condition": {"type": "string"}}}},
    "symmetry": {"type": "object"},
    "three_state_profile": {"type": "object"},
    "longitudinal": {"type": ["object", "null"]},
    "scores": {"type": "object"},
    "top_contributors": {"type": "array"},
    "consistency": {"type": ["string", "object"]},
    "confound_warnings": {"type": "array", "items": {"type": "string"}},
    "guarantee_note": {"type": "string"},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "plots": {"type": ["array", "object"]},
    "audit": {"type": "object"}
  },
  "additionalProperties": true
}
